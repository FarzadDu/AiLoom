{
  "name": "ailoom",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "worker": "node --import tsx scripts/worker.ts",
    "worker:local": "node --env-file=.env --import tsx scripts/worker.ts",
    "renderer": "node --import tsx scripts/render-worker.ts",
    "renderer:local": "node --env-file=.env --import tsx scripts/render-worker.ts",
    "worker:lora": "node --import tsx scripts/lora-worker.ts",
    "worker:lora:local": "node --env-file=.env --import tsx scripts/lora-worker.ts",
    "worker:dubbing": "node --import tsx scripts/dubbing-worker.ts",
    "worker:dubbing:local": "node --env-file=.env --import tsx scripts/dubbing-worker.ts",
    "migrate": "node --import tsx scripts/migrate.ts",
    "seed:specialists": "node --import tsx scripts/seed-specialists.ts"
  },
  "dependencies": {
    "better-auth": "1.7.6",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.3",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "1.48.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.13.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.0.0",
    "drizzle-kit": "0.31.11",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
