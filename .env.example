# Ailoom provider keys. Paste values only into .env; never commit that file.
OPENROUTER_API_KEY=
KIE_API_KEY=
FAL_KEY=
WAVESPEED_API_KEY=
ELEVENLABS_API_KEY=

# Invite-only account setup and deployment.
ADMIN_EMAIL=
PUBLIC_BASE_URL=http://localhost:3000
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
DATABASE_PATH=data/ailoom.sqlite
MEDIA_DIR=data/media
